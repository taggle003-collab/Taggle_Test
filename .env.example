# LLM API Configuration (OpenRouter) - PRIMARY LEAD GENERATOR
# API Key for accessing open-source models like DeepSeek-V3
# Get your key at: https://openrouter.ai (starts with 'sk-or-')
LLM_API_KEY=

# Base URL for the LLM API (defaults to OpenRouter)
LLM_API_BASE_URL=https://openrouter.ai/api/v1

# Model to use for lead generation (recommended: deepseek/deepseek-chat for DeepSeek-V3)
# Alternative options: meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-r1-distill-llama-70b
LLM_MODEL_NAME=deepseek/deepseek-chat

# Kaggle API - FALLBACK LEAD GENERATOR
# Token-based auth for scraping additional lead data from Kaggle datasets
# This is optional and used as a fallback when LLM returns insufficient leads
KAGGLE_API_TOKEN=

# If true, allow generating mock fallback leads / using mock fallback scrapers when real scrapers fail.
# Recommended: leave unset/false in production to avoid masking configuration issues.
ALLOW_MOCK_FALLBACK=false

# Legacy Gemini API key (Google Generative AI) - kept for backward compatibility only
GOOGLE_GENERATIVE_AI_KEY=
GEMINI_API_KEY=
